rules_version = '2';

// ============================================================
// KBAL-School — Storage security rules
// Deploy with:  firebase deploy --only storage:rules
// Signed-in users (students, teachers, admins) may upload files
// up to 20 MB. Everyone may read them (images/files are public).
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/.*|text/.*|video/.*|audio/.*');
    }
  }
}
