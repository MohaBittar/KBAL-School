rules_version = '2';

// ============================================================
// KBAL-School — Firestore security rules
// Deploy with:  firebase deploy --only firestore:rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function settingsExist() {
      return exists(/databases/$(database)/documents/site/main);
    }

    function isAdmin() {
      return signedIn() && (
        myRole() == 'admin'
        // bootstrap admin: works even before the settings document exists
        || request.auth.token.email == 'mohabittarinfo12@gmail.com'
        || (settingsExist()
            && request.auth.token.email in get(/databases/$(database)/documents/site/main).data.adminEmails)
      );
    }

    // Users explicitly allowed by an admin to publish announcements
    function canAnnounce() {
      return isAdmin()
        || (profileExists()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canAnnounce == true);
    }

    // ---- public content ----
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      // admins + users the admin gave the "can announce" permission
      allow create: if isAdmin() || canAnnounce();
      allow update, delete: if isAdmin()
        || (canAnnounce() && resource.data.authorUid == request.auth.uid);
    }

    // ---- per-user notifications (fan-out when an announcement is posted) ----
    match /users/{userId}/notifications/{noteId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && (isAdmin() || canAnnounce())
        && request.resource.data.type == 'announcement'
        && request.resource.data.keys().hasOnly(['type', 'title', 'body', 'annId', 'classId', 'authorName', 'atMs']);
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    // ---- classes (everyone may read them: students need the list to join) ----
    match /classes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- user profiles ----
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && (isAdmin()
            || (request.resource.data.role == 'student'
                && request.resource.data.get('canAnnounce', false) == false));   // students cannot grant themselves announce rights
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.role == resource.data.role                 // users may edit their own profile but never their role
            && request.resource.data.get('canAnnounce', false)
               == resource.data.get('canAnnounce', false));                     // ...and never their announce permission
      allow delete: if isAdmin();
    }

    // ---- chats: rooms + direct messages ----
    match /chats/{chatId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin();            // only admins may edit messages
        allow delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);  // authors may delete their own
      }
    }

    // everything else is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
